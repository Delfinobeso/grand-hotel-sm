# Secret amministrativo per POST /api/push/send (header x-push-secret).
# Genera un valore lungo e casuale, es:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Impostalo come Environment Variable su Vercel. IDENTICO sui 3 hotel.
# Se non impostato, /api/push/send resta disabilitato (risponde 401).
PUSH_ADMIN_SECRET=

# VAPID — Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:push@blasat.com

# Concierge AI
DEEPSEEK_API_KEY=
